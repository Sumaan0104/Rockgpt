# ═════════════════════════════════════════════════════════════
# ROCKGPT BACKEND ENVIRONMENT CONFIGURATION (Render / Production)
# ═════════════════════════════════════════════════════════════

# Express Port
PORT=5000

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/rockgpt?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/rockgpt?retryWrites=true&w=majority

# JWT Authentication Secret Key (Random 32+ character string)
JWT_SECRET=your_production_jwt_secret_key_change_me_to_random_string

# Groq Cloud API Key (for high-speed streaming LLM inference)
# Obtain from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Google Gemini API Key (multimodal vision + fallback engine)
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# Google OAuth 2.0 Web Client ID (Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Razorpay Payment Gateway (Optional for Plus / Pro automated upgrades)
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Allowed Frontend Origins (Comma-separated)
CLIENT_URL=https://rockgpt-ten.vercel.app
