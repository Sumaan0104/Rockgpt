# RockGPT Frontend Environment Variables
# Copy to .env or .env.local to customize

# Backend API endpoint (defaults to production Render URL if omitted)
VITE_BACKEND_URL=https://rockgpt.onrender.com

# Google Cloud OAuth 2.0 Web Client ID
# Obtain from https://console.cloud.google.com/apis/credentials
# Format: <project-number>-<hash>.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=
