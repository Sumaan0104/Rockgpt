# ═════════════════════════════════════════════════════════════
# ROCKGPT FRONTEND ENVIRONMENT CONFIGURATION (Vercel / Local)
# ═════════════════════════════════════════════════════════════

# Google OAuth 2.0 Client ID (Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Backend API URL (Optional override; defaults to https://rockgpt.onrender.com)
VITE_API_URL=https://rockgpt.onrender.com/api
